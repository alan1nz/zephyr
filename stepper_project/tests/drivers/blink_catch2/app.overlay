/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Constructs a real blink-gpio-led instance on native_sim's emulated GPIO
 * (gpio0 is "zephyr,gpio-emul", already enabled in native_sim.dts).
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	my_led1: my-led {
		compatible = "blink-gpio-led";
		led-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		blink-period-ms = <100>;
		status = "okay";
	};
};
