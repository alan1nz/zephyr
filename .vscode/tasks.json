{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ESP32S3",
            "type": "shell",
            "icon": {
                "id": "coffee",
                "color": "terminal.ansiGreen"
            },
            "command": "west",
            "args": [
                "build",
                "--p",
                "-b",
                "esp32s3_devkitc/esp32s3/procpu",
                "app"
            ],
            "options": {
                "cwd": "${workspaceFolder}/stepper_project/"
            },
            "problemMatcher": []
        },
        {
            "label": "Build L432",
            "type": "shell",
            "icon": {
                "id": "coffee",
                "color": "terminal.ansiGreen"
            },
            "command": "west",
            "args": [
                "build",
                "--p",
                "-b",
                "nucleo_l432kc",
                "app"
            ],
            "options": {
                "cwd": "${workspaceFolder}/stepper_project/"
            },
            "problemMatcher": []
        },
        {
            "label": "West Flash",
            "command": "${workspaceFolder}/.venv/bin/west",
            "icon": {
                "id": "arrow-circle-right",
                "color": "terminal.ansiGreen"
            },
            "args": [
                "flash",
                "--no-rebuild"
            ],
            "problemMatcher":[],
            "options": {
                "cwd": "${workspaceFolder}/stepper_project/"
            },
        }
    ]
}